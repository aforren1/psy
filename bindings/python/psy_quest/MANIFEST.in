# An sdist must carry everything the build needs. setup.py compiles
# psy_quest.h straight into the extension with PSYQ_ASYNC defined, and under
# PSYQ_ASYNC that header includes psy_rt.h. Both live at the repository root,
# which an sdist cannot reach, so stage a copy of the two next to setup.py
# first:
#
#     cp ../../../psy_quest.h ../../../psy_rt.h .
#     uv build --sdist
#
# The staged copies are gitignored; setup.py prefers the repository root when
# it is present, so a copy cannot shadow a newer header in a development tree.
include psy_quest.h
include psy_rt.h
# setup.py names the extension source by absolute path, which sdist does not
# pick up on its own.
include psy_quest_ext.c
include example.py
recursive-include tests *.py
