# An sdist must carry everything the build needs. setup.py compiles ysp/aep.h
# straight into the extension with YAEP_ASYNC defined, and under that macro
# the header includes ysp/rt.h. Both live in include/ysp/ under the repository root, which an
# sdist cannot reach, so stage a copy of the two in include/ysp/ next to setup.py first:
#
#     mkdir -p include/ysp && cp ../../../include/ysp/aep.h ../../../include/ysp/rt.h include/ysp/
#     python -m build --sdist        (or: uv build --sdist)
#
# CI copies the same two headers in the "Stage headers into the package" step
# of .github/workflows/ci.yml before cibuildwheel runs. The staged copies are
# gitignored; setup.py prefers the repository root when it is present, so a
# copy cannot shadow a newer header in a development tree.
include include/ysp/aep.h
include include/ysp/rt.h
# setup.py names the extension source by absolute path, which sdist does not
# pick up on its own.
include ysp_aep_ext.c
include example.py
include tests/test_aep.py
