# An sdist must carry everything the build needs. setup.py compiles
# psy_trials.h straight into the extension, and the header lives at the
# repository root, which an sdist cannot reach, so stage a copy next to
# setup.py first:
#
#     cp ../../../psy_trials.h .
#     uv build --sdist
#
# The staged copies are gitignored; setup.py prefers the repository root when
# it is present, so a copy cannot shadow a newer header in a development tree.
# psy_trials.h includes psy_table.h, so both are staged:
#
#     cp ../../../psy_table.h .
include psy_trials.h
include psy_table.h
# setup.py names the extension source by absolute path, which sdist does not
# pick up on its own.
include psy_trials_ext.c
include example.py
recursive-include tests *.py
