# An sdist must carry everything the build needs. setup.py compiles psy_gp.h
# straight into the extension with PSYGP_ASYNC defined, and under that macro
# the header includes psy_rt.h. Both live at the repository root, which an
# sdist cannot reach, so stage a copy of the two next to setup.py first:
#
#     cp ../../../psy_gp.h ../../../psy_rt.h .
#     python -m build --sdist        (or: uv build --sdist)
#
# CI copies the same two headers in the "Stage headers into the package" step
# of .github/workflows/ci.yml before cibuildwheel runs. The staged copies are
# gitignored; setup.py prefers the repository root when it is present, so a
# copy cannot shadow a newer header in a development tree.
include psy_gp.h
include psy_rt.h
# setup.py names the extension source by absolute path, which sdist does not
# pick up on its own.
include psy_gp_ext.c
include example.py
include tests/test_gp.py
