# build output
build*/
compile_commands.json
*.o
*.obj
*.so
*.dll
*.pyd
*.mex*
*.oct
*.exe
*.pdb
*.ilk
*.exp

# example output written to the working directory (data files, --shots images)
/*.csv
/*.ppm
/*.pgm

# libFuzzer artifacts (tests/fuzz/)
crash-*
leak-*
timeout-*
oom-*
slow-unit-*
*.profraw

# python
__pycache__/
.pytest_cache/
.venv/
dist/
wheelhouse/
*.egg-info/
*.egg

# headers staged into a python binding for isolated/CI builds
bindings/python/*/include/

# logs and crash dumps
logs/
*.log
*.stackdump
*.dmp

# editor / OS
.vscode/
.cache/
CMakeUserPresets.json
.DS_Store

# vendored layout sources: fetched and verified by tools/vendor_layout.py
# (third_party/README.md); the recipe (patches, manifest, CMake) is tracked
/third_party/*/
!/third_party/patches/
